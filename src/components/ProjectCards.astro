---
import type { Locale } from "../data/locales";
import { route } from "../data/routes";

interface Props {
  locale: Locale;
  projects: { title: string; summary: string; overview: string }[];
  labels: {
    summaryProject: string;
    collaborateProject: string;
    close: string;
  };
}

const { locale, projects } = Astro.props;
const projectArtwork: Record<string, { slug: string; filename: string }> = {
  "Alpha Linux": { slug: "alpha-linux", filename: "Alpha-Linux.webp" },
  "Company Platform": { slug: "company-platform", filename: "Company-Platform.webp" },
  "ZTF Classifier": { slug: "ztf-classifier", filename: "ZTF-Classifier.webp" }
};
const assetBase = import.meta.env.BASE_URL.replace(/\/+$/, "");
---

<div class="project-grid">
  {projects.map((project) => {
    const artwork = projectArtwork[project.title];
    const imageSrc = artwork ? `${assetBase}/assets/domains/${artwork.filename}` : undefined;
    const detailHref = artwork ? route(locale, `projects/${artwork.slug}`) : route(locale, "projects");
    return (
      <article class="project-card">
        {imageSrc && (
          <img
            class="project-card__image"
            src={imageSrc}
            alt=""
            loading="lazy"
            decoding="async"
          />
        )}
        <h3>{project.title}</h3>
        <p>{project.summary}</p>
        <div class="card-actions">
          <a class="button button-secondary" href={detailHref}>
            {locale === "fa" ? "صفحه پروژه" : locale === "ar" ? "صفحة المشروع" : locale === "ru" ? "Страница проекта" : locale === "de" ? "Projektseite" : locale === "zh" ? "项目页面" : locale === "fr" ? "Page du projet" : locale === "es" ? "Página del proyecto" : "Project page"}
          </a>
        </div>
      </article>
    );
  })}
</div>
