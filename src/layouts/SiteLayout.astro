---
import type { Locale } from "../data/locales";
import { localeMeta, locales } from "../data/locales";
import { content } from "../content/site";
import { ui } from "../content/ui";
import { ceo } from "../content/ceo";
import { route } from "../data/routes";
import { webLogoUrl } from "../data/brand";
import { formatFounded } from "../utils/date-format";
import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const site = content[locale];
const meta = localeMeta[locale];
const labels = ui[locale];
const profile = ceo[locale];
const origin = Astro.site?.toString().replace(/\/$/, "") ?? "";
const path = Astro.url.pathname;
const base = path.replace(/^.*?\/(fa|en|ar|ru|de|zh|fr|es)(?=\/|$)/, "");
const isLocalizedPage = /\/(fa|en|ar|ru|de|zh|fr|es)(?:\/|$)/.test(path);
const isNotFoundPage = path.endsWith("/404.html") || path.endsWith("/404/");
const isCeoProfilePage = /\/(fa|en|ar|ru|de|zh|fr|es)\/company\/ceo\/?$/.test(path);
const localePath = isLocalizedPage ? base : "";

const localeForOg: Record<Locale, string> = {
  fa: "fa_IR", en: "en_US", ar: "ar_AR", ru: "ru_RU",
  de: "de_DE", zh: "zh_CN", fr: "fr_FR", es: "es_ES"
};

const logoUrl = origin ? new URL(webLogoUrl, origin).toString() : "";
const legalCompanyName = "شرکت پیشگامان نواندیش فناورگستر کیهان (مسئولیت محدود)";
const personSameAs = [
  "https://linkedin.com/in/saeed-memarzadeh-12559146",
  "https://github.com/saeed92m",
  "https://instagram.com/saeed92m",
  "https://scholar.google.com/citations?user=Agge5hoAAAAJ"
];

const organization = {
  "@type": "Organization",
  "@id": origin + "/#organization",
  "name": site.companyName,
  "legalName": legalCompanyName,
  "alternateName": "Pishgaman Novandish Fannavargostar Keyhan",
  "url": origin,
  ...(logoUrl ? { "logo": logoUrl } : {}),
  "foundingDate": "2023-07-29",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Tabriz",
    "addressRegion": "East Azerbaijan",
    "addressCountry": "IR"
  },
  "brand": { "@type": "Brand", "name": "ALPHA TEAM" },
  "founder": { "@id": origin + "/#person" }
};

const person = {
  "@type": "Person",
  "@id": origin + "/#person",
  "name": profile.name,
  "jobTitle": profile.role,
  "url": origin + route(locale, "company/ceo"),
  "sameAs": personSameAs,
  "worksFor": { "@id": origin + "/#organization" },
  "alumniOf": { "@type": "CollegeOrUniversity", "name": "University of Tabriz" }
};

const graph: Record<string, unknown>[] = [
  organization,
  person,
  {
    "@type": "WebSite",
    "@id": origin + "/#website",
    "name": "ALPHA TEAM",
    "url": origin,
    "inLanguage": locale,
    "publisher": { "@id": origin + "/#organization" }
  }
];

if (isCeoProfilePage) {
  graph.push({
    "@type": "ProfilePage",
    "@id": origin + path + "#profile",
    "url": origin + path,
    "mainEntity": { "@id": origin + "/#person" }
  });
}

const structuredData = origin
  ? JSON.stringify({ "@context": "https://schema.org", "@graph": graph })
  : "";
---
<!doctype html>
<html lang={locale} dir={meta.dir} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ?? site.companyName}</title>
    <meta name="theme-color" content="#07111f" />
    <meta name="author" content={profile.name} />
    <link rel="icon" type="image/svg+xml" href={webLogoUrl} />
    <meta name="description" content={description ?? site.intro} />
    <meta name="robots" content={isNotFoundPage ? "noindex,follow" : "index,follow"} />
    <meta property="og:site_name" content="ALPHA TEAM" />
    <meta property="og:locale" content={localeForOg[locale]} />
    <meta property="og:title" content={title ?? site.companyName} />
    <meta property="og:description" content={description ?? site.intro} />
    <meta property="og:type" content={isCeoProfilePage ? "profile" : "website"} />
    {origin && !isNotFoundPage && <meta property="og:url" content={new URL(path, origin)} />}
    {logoUrl && !isNotFoundPage && <meta property="og:image" content={logoUrl} />}
    {logoUrl && !isNotFoundPage && <meta property="og:image:alt" content="ALPHA TEAM — Pishgaman Novandish Fannavargostar Keyhan" />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title ?? site.companyName} />
    <meta name="twitter:description" content={description ?? site.intro} />
    {logoUrl && !isNotFoundPage && <meta name="twitter:image" content={logoUrl} />}
    {origin && !isNotFoundPage && <link rel="canonical" href={new URL(path, origin)} />}
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    {origin && isLocalizedPage && locales.map((code) => <link rel="alternate" hreflang={code} href={new URL(route(code, base), origin)} />)}
    {origin && isLocalizedPage && <link rel="alternate" hreflang="x-default" href={new URL(route("en", base), origin)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels.skipToContent}</a>
    <header class="site-header site-shell">
      <a class="brand" href={route(locale)} aria-label={"ALPHA TEAM — " + site.companyName}>
        <span class="brand-mark" aria-hidden="true"><BrandMark label="ALPHA TEAM" /></span>
        <span class="brand-wordmark">ALPHA TEAM</span>
      </a>
      <nav class="primary-nav" aria-label={site.navigation.company}>
        <a href={route(locale,"company")}>{site.navigation.company}</a>
        <a href={route(locale,"fields")}>{site.navigation.fields}</a>
        <a href={route(locale,"projects")}>{site.navigation.projects}</a>
        <a href={route(locale,"company/ceo")}>{site.navigation.ceo}</a>
        <a href={route(locale,"contact")}>{site.navigation.contact}</a>
      </nav>
      <div class="header-tools">
        <label class="language-select">
          <span class="sr-only">{labels.language}</span>
          <select aria-label={labels.language}>
            {locales.map((code) => <option value={route(code, localePath)} selected={code === locale}>{localeMeta[code].label}</option>)}
          </select>
        </label>
        <button class="theme-toggle" type="button" aria-label={labels.theme} aria-pressed="true" data-theme-toggle>
          <span aria-hidden="true">☾</span>
          <span data-theme-label>{labels.night}</span>
        </button>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="site-shell footer-grid">
        <div>
          <p class="footer-brand">ALPHA TEAM</p>
          <p>{site.companyName}</p>
        </div>
        <div>
          <p class="footer-kicker">{site.navigation.fields}</p>
          <p>{site.fields.map((field) => field.title).join(" · ")}</p>
        </div>
        <div>
          <p class="footer-kicker">{site.navigation.contact}</p>
          <p>{site.location} · {formatFounded(locale)}</p>
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const stored = localStorage.getItem("site-theme");
        if (stored === "light" || stored === "dark") root.dataset.theme = stored;
        const toggle = document.querySelector("[data-theme-toggle]");
        const label = document.querySelector("[data-theme-label]");
        const select = document.querySelector(".language-select select");
        const labels = {
          fa: { night: "شب", day: "روز" }, en: { night: "Night", day: "Day" },
          ar: { night: "ليل", day: "نهار" }, ru: { night: "Ночь", day: "День" },
          de: { night: "Nacht", day: "Tag" }, zh: { night: "夜间", day: "日间" },
          fr: { night: "Nuit", day: "Jour" }, es: { night: "Noche", day: "Día" }
        };
        const currentLocale = document.documentElement.lang || "fa";
        const updateThemeUi = () => {
          const isDark = root.dataset.theme !== "light";
          if (toggle) toggle.setAttribute("aria-pressed", String(isDark));
          if (label) label.textContent = isDark ? labels[currentLocale].night : labels[currentLocale].day;
          const icon = toggle?.querySelector("span[aria-hidden]");
          if (icon) icon.textContent = isDark ? "☾" : "☀";
        };
        updateThemeUi();
        toggle?.addEventListener("click", () => {
          root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
          localStorage.setItem("site-theme", root.dataset.theme);
          updateThemeUi();
        });
        select?.addEventListener("change", (event) => {
          const target = event.currentTarget;
          if (target instanceof HTMLSelectElement && target.value) window.location.href = target.value;
        });
      })();
    </script>
  </body>
</html>
