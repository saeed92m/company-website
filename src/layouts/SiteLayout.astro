---
import type { Locale } from "../data/locales";
import { localeMeta, locales } from "../data/locales";
import { content } from "../content/site";
import { ui } from "../content/ui";

interface Props { locale: Locale; title?: string; description?: string; }
const { locale, title, description } = Astro.props;
const site = content[locale];
const meta = localeMeta[locale];
const labels = ui[locale];
const origin = Astro.site?.toString().replace(/\/$/, "") ?? "";
const path = Astro.url.pathname;
const base = path.replace(/^\/(fa|en|ar|ru|de|zh|fr|es)(?=\/|$)/, "");
const structuredData = origin ? JSON.stringify({
  "@context":"https://schema.org",
  "@graph":[
    {"@type":"Organization","@id":origin+"/#organization","name":site.companyName,"url":origin,"founder":{"@id":origin+"/#person"}},
    {"@type":"Person","@id":origin+"/#person","name":site.founder.replace(/^.*:\s*/, ""), "jobTitle":locale === "fa" ? "بنیانگذار و مدیرعامل" : "Founder & CEO","url":origin+"/"+locale+"/company/ceo/"},
    {"@type":"WebSite","@id":origin+"/#website","name":site.companyName,"url":origin,"inLanguage":locale}
  ]
}) : "";
---
<!doctype html>
<html lang={locale} dir={meta.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description ?? site.intro} />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title ?? site.companyName} />
    <meta property="og:description" content={description ?? site.intro} />
    <meta property="og:type" content="website" />
    {origin && <link rel="canonical" href={new URL(path, origin)} />}\n    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    {origin && locales.map((code) => <link rel="alternate" hreflang={code} href={new URL("/" + code + base, origin)} />)}
    {origin && <link rel="alternate" hreflang="x-default" href={new URL("/en" + base, origin)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels.skipToContent}</a>
    <header class="site-header site-shell">
      <a class="brand" href={"/" + locale + "/"} aria-label={site.companyName}>PNFK</a>
      <nav aria-label={site.navigation.company}>
        <a href={"/" + locale + "/#company"}>{site.navigation.company}</a>
        <a href={"/" + locale + "/#fields"}>{site.navigation.fields}</a>
        <a href={"/" + locale + "/projects/"}>{site.navigation.projects}</a>
        <a href={"/" + locale + "/company/ceo/"}>{site.navigation.ceo}</a>
        <a href={"/" + locale + "/contact/"}>{site.navigation.contact}</a>
      </nav>
      <nav class="language-nav" aria-label={labels.language}>
        {locales.map((code) => <a href={"/" + code + base} lang={code} aria-current={code === locale ? "page" : undefined}>{localeMeta[code].label}</a>)}
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer site-shell">
      <p>{site.companyName}</p>
      <p>{site.location} · {site.founded}</p>
    </footer>
  </body>
</html>
