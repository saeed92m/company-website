---
import type { Locale } from "../data/locales";
import { localeMeta, locales } from "../data/locales";
import { content } from "../content/site";
import { ui } from "../content/ui";
import { ceo } from "../content/ceo";
import { route } from "../data/routes";
import { resolveSiteUrl } from "../utils/site-url.mjs";
import { webLogoUrl } from "../data/brand";
import { formatFounded } from "../utils/date-format";
import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";
import "../styles/design-system.css";
import "../styles/screenshot-review.css";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const site = content[locale];
const meta = localeMeta[locale];
const labels = ui[locale];
const menuUi: Record<Locale, { menu: string; close: string; home: string; intro: string; board: string; navigation: string }> = {
  fa: { menu: "فهرست", close: "بستن فهرست", home: "صفحه اصلی", intro: "معرفی", board: "هیئت‌مدیره", navigation: "ناوبری اصلی" },
  en: { menu: "Menu", close: "Close menu", home: "Home", intro: "Overview", board: "Board of Directors", navigation: "Main navigation" },
  ar: { menu: "القائمة", close: "إغلاق القائمة", home: "الرئيسية", intro: "نبذة عن الشركة", board: "مجلس الإدارة", navigation: "التنقل الرئيسي" },
  ru: { menu: "Меню", close: "Закрыть меню", home: "Главная", intro: "О компании", board: "Совет директоров", navigation: "Основная навигация" },
  de: { menu: "Menü", close: "Menü schließen", home: "Startseite", intro: "Unternehmensprofil", board: "Vorstand", navigation: "Hauptnavigation" },
  zh: { menu: "菜单", close: "关闭菜单", home: "首页", intro: "公司简介", board: "董事会", navigation: "主导航" },
  fr: { menu: "Menu", close: "Fermer le menu", home: "Accueil", intro: "Présentation", board: "Conseil d’administration", navigation: "Navigation principale" },
  es: { menu: "Menú", close: "Cerrar menú", home: "Inicio", intro: "Presentación", board: "Junta directiva", navigation: "Navegación principal" }
};
const profile = ceo[locale];
const origin = Astro.site?.toString().replace(/\/$/, "") ?? "";
const path = Astro.url.pathname;
const base = path.replace(/^.*?\/(fa|en|ar|ru|de|zh|fr|es)(?=\/|$)/, "");
const isLocalizedPage = /\/(fa|en|ar|ru|de|zh|fr|es)(?:\/|$)/.test(path);
const isNotFoundPage = path.endsWith("/404.html") || path.endsWith("/404/");
const isCeoProfilePage = /\/(fa|en|ar|ru|de|zh|fr|es)\/company\/ceo\/?$/.test(path);
const localePath = isLocalizedPage ? base : "";

const localeForOg: Record<Locale, string> = {
  fa: "fa_IR", en: "en_US", ar: "ar_AR", ru: "ru_RU",
  de: "de_DE", zh: "zh_CN", fr: "fr_FR", es: "es_ES"
};

const logoUrl = origin ? new URL(webLogoUrl, origin).toString() : "";
const legalCompanyName = "شرکت پیشگامان نواندیش فناورگستر کیهان (مسئولیت محدود)";
const personSameAs = [
  "https://linkedin.com/in/saeed-memarzadeh-12559146",
  "https://github.com/saeed92m",
  "https://instagram.com/saeed92m",
  "https://scholar.google.com/citations?user=Agge5hoAAAAJ"
];

const organization = {
  "@type": "Organization",
  "@id": origin + "/#organization",
  "name": site.companyName,
  "legalName": legalCompanyName,
  "alternateName": "Pishgaman Novandish Fannavargostar Keyhan",
  "url": origin,
  ...(logoUrl ? { "logo": logoUrl } : {}),
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Tabriz",
    "addressRegion": "East Azerbaijan",
    "addressCountry": "IR"
  },
  "brand": { "@type": "Brand", "name": site.companyName },
  "founder": { "@id": origin + "/#person" }
};

const person = {
  "@type": "Person",
  "@id": origin + "/#person",
  "name": profile.name,
  "jobTitle": profile.role,
  "url": resolveSiteUrl(route(locale, "company/ceo"), origin),
  "sameAs": personSameAs,
  "worksFor": { "@id": origin + "/#organization" },
  "alumniOf": { "@type": "CollegeOrUniversity", "name": "University of Tabriz" }
};

const graph: Record<string, unknown>[] = [
  organization,
  person,
  {
    "@type": "WebSite",
    "@id": origin + "/#website",
    "name": site.companyName,
    "url": origin,
    "inLanguage": locale,
    "publisher": { "@id": origin + "/#organization" }
  }
];

if (isCeoProfilePage) {
  graph.push({
    "@type": "ProfilePage",
    "@id": resolveSiteUrl(path, origin) + "#profile",
    "url": resolveSiteUrl(path, origin),
    "mainEntity": { "@id": origin + "/#person" }
  });
}

const structuredData = origin ? serializeJsonLd(graph) : "";
import { serializeJsonLd } from "../utils/serialize-jsonld.mjs";
---
<!doctype html>
<html lang={locale} dir={meta.dir} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ?? site.companyName}</title>
    <meta name="theme-color" content="#07111f" data-theme-color />
    <meta name="author" content={profile.name} />
    <link rel="icon" type="image/svg+xml" href={webLogoUrl} />
    <meta name="description" content={description ?? site.intro} />
    <meta name="robots" content={isNotFoundPage ? "noindex,follow" : "index,follow"} />
    <meta name="google-site-verification" content="kTQUPwNOP6x5RNqDWtHOSG-KstdG9cWiKPrl3jWcQUE" />
    <meta property="og:site_name" content={site.companyName} />
    <meta property="og:locale" content={localeForOg[locale]} />
    <meta property="og:title" content={title ?? site.companyName} />
    <meta property="og:description" content={description ?? site.intro} />
    <meta property="og:type" content={isCeoProfilePage ? "profile" : "website"} />
    {origin && !isNotFoundPage && <meta property="og:url" content={new URL(path, origin)} />}
    {logoUrl && !isNotFoundPage && <meta property="og:image" content={logoUrl} />}
    {logoUrl && !isNotFoundPage && <meta property="og:image:alt" content={site.companyName + " logo"} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title ?? site.companyName} />
    <meta name="twitter:description" content={description ?? site.intro} />
    {logoUrl && !isNotFoundPage && <meta name="twitter:image" content={logoUrl} />}
    {origin && !isNotFoundPage && <link rel="canonical" href={new URL(path, origin)} />}
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    {origin && isLocalizedPage && locales.map((code) => <link rel="alternate" hreflang={code} href={new URL(route(code, base), origin)} />)}
    {origin && isLocalizedPage && <link rel="alternate" hreflang="x-default" href={new URL(route("en", base), origin)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels.skipToContent}</a>
    <header class="site-header site-shell">
      <a class="brand" href={route(locale)} aria-label={site.companyName}>
        <span class="brand-mark" aria-hidden="true"><BrandMark label={site.companyName} /></span>
        <span class="brand-wordmark">{site.companyName}</span>
      </a>
      <nav id="primary-navigation" class="primary-nav" aria-label={menuUi[locale].navigation} data-primary-nav>
        <a href={route(locale)} aria-current={path === route(locale) ? "page" : undefined}>{menuUi[locale].home}</a>
        <details class="nav-group" data-nav-group data-current={path.startsWith(route(locale,"company")) ? "true" : undefined}>
          <summary>{site.navigation.company}</summary>
          <div class="nav-submenu">
            <a href={route(locale,"company")} aria-current={path === route(locale,"company") ? "page" : undefined}>{menuUi[locale].intro}</a>
            <a href={route(locale,"company/ceo")} aria-current={path === route(locale,"company/ceo") ? "page" : undefined}>{menuUi[locale].board}</a>
          </div>
        </details>
        <details class="nav-group" data-nav-group data-current={path.startsWith(route(locale,"fields")) ? "true" : undefined}>
          <summary>{site.navigation.fields}</summary>
          <div class="nav-submenu">
            {site.fields.map((field) => <a href={route(locale,"fields/"+field.slug)} aria-current={path === route(locale,"fields/"+field.slug) ? "page" : undefined}>{field.title}</a>)}
          </div>
        </details>
        <a href={route(locale,"projects")} aria-current={path === route(locale,"projects") ? "page" : undefined}>{site.navigation.projects}</a>
        <a href={route(locale,"contact")} aria-current={path === route(locale,"contact") ? "page" : undefined}>{site.navigation.contact}</a>
      </nav>
      <div class="header-tools">
        <label class="language-select">
          <span class="sr-only">{labels.language}</span>
          <select aria-label={labels.language}>
            {locales.map((code) => <option value={route(code, localePath)} selected={code === locale}>{localeMeta[code].label}</option>)}
          </select>
        </label>
        <button class="theme-toggle" type="button" aria-label={labels.theme} aria-pressed="true" data-theme-toggle>
          <span aria-hidden="true">☾</span>
          <span data-theme-label>{labels.night}</span>
        </button>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="site-shell footer-grid">
        <div>
          <p class="footer-brand">{site.companyName}</p>
          <p>{site.intro}</p>
        </div>
        <div>
          <p class="footer-kicker">{site.navigation.fields}</p>
          <p>{site.fields.map((field) => field.title).join(" · ")}</p>
        </div>
        <div>
          <p class="footer-kicker">{site.navigation.contact}</p>
          <p>{site.location} · {formatFounded(locale)}</p>
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let stored = null;
        try { stored = localStorage.getItem("site-theme"); } catch {}
        if (stored === "light" || stored === "dark") root.dataset.theme = stored;
        const toggle = document.querySelector("[data-theme-toggle]");
        const label = document.querySelector("[data-theme-label]");
        const select = document.querySelector(".language-select select");
        const menu = document.querySelector("[data-primary-nav]");
        const menuGroups = Array.from(document.querySelectorAll("[data-nav-group]"));
        const labels = {
          fa: { night: "شب", day: "روز" }, en: { night: "Night", day: "Day" },
          ar: { night: "ليل", day: "نهار" }, ru: { night: "Ночь", day: "День" },
          de: { night: "Nacht", day: "Tag" }, zh: { night: "夜间", day: "日间" },
          fr: { night: "Nuit", day: "Jour" }, es: { night: "Noche", day: "Día" }
        };
        const currentLocale = document.documentElement.lang || "fa";
        const updateThemeUi = () => {
          const isDark = root.dataset.theme !== "light";
          const themeColor = document.querySelector("[data-theme-color]");
          if (themeColor) themeColor.setAttribute("content", isDark ? "#07111f" : "#f8fafc");
          if (toggle) toggle.setAttribute("aria-pressed", String(isDark));
          if (label) label.textContent = isDark ? labels[currentLocale].night : labels[currentLocale].day;
          const icon = toggle?.querySelector("span[aria-hidden]");
          if (icon) icon.textContent = isDark ? "☾" : "☀";
        };
        updateThemeUi();
        menu?.addEventListener("click", (event) => {
          if (event.target instanceof Element && event.target.closest("a")) {
            menuGroups.forEach((group) => { group.open = false; });
          }
        });
        menuGroups.forEach((group) => group.addEventListener("toggle", () => {
          if (group.open) menuGroups.forEach((other) => { if (other !== group) other.open = false; });
        }));
        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          const openGroup = menuGroups.find((group) => group.open);
          if (openGroup) {
            openGroup.open = false;
            openGroup.querySelector("summary")?.focus();
          }
        });
        document.addEventListener("click", (event) => {
          if (event.target instanceof Node && !document.querySelector(".site-header")?.contains(event.target)) {
            menuGroups.forEach((group) => { group.open = false; });
          }
        });
        toggle?.addEventListener("click", () => {
          root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
          try { localStorage.setItem("site-theme", root.dataset.theme); } catch {}
          updateThemeUi();
        });
        select?.addEventListener("change", (event) => {
          const target = event.currentTarget;
          if (target instanceof HTMLSelectElement && target.value) window.location.href = target.value;
        });
      })();
    </script>
  </body>
</html>