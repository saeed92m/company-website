---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { locales, type Locale } from "../../../data/locales";
import { content } from "../../../content/site";
import { domainImageUrl, domainDiagramUrl } from "../../../data/domain-assets";
import { domainDeepContent, domainDeepLabels } from "../../../content/domain-deep-content";

export function getStaticPaths() {
  return locales.flatMap((locale) => content[locale].fields.map((field) => ({
    params: { locale, slug: field.slug }, props: { locale, field }
  })));
}

const { locale, field } = Astro.props as { locale: Locale; field: (typeof content.en.fields)[number] };
const site = content[locale];
const detail = domainDeepContent[locale][field.slug];
const labels = domainDeepLabels[locale];
const diagramAlt: Record<Locale, Record<string, string>> = {
  fa: {
    astronomy: "نمودار مفهومی تحلیل منحنی نوری نجومی",
    aerospace: "شماتیک مفهومی میدان جریان پیرامون مقطع بال",
    "remote-sensing": "نمایش مفهومی لایه‌های داده سنجش از دور",
    "artificial-intelligence": "نمودار مفهومی شبکه یادگیری ماشین",
    energy: "دیاگرام مفهومی ریزشبکه ترکیبی",
    motorsport: "نمودار مفهومی تله‌متری قوای محرکه"
  },
  en: {
    astronomy: "Conceptual astronomical light-curve analysis",
    aerospace: "Conceptual flow field around an airfoil",
    "remote-sensing": "Conceptual earth-observation data layers",
    "artificial-intelligence": "Conceptual machine-learning network",
    energy: "Conceptual hybrid microgrid",
    motorsport: "Conceptual powertrain telemetry chart"
  },
  ar: {
    astronomy: "رسم توضيحي لتحليل منحنى ضوئي فلكي",
    aerospace: "رسم توضيحي لمجال تدفق حول مقطع جناح",
    "remote-sensing": "طبقات توضيحية لبيانات رصد الأرض",
    "artificial-intelligence": "رسم توضيحي لشبكة تعلم آلي",
    energy: "مخطط توضيحي لشبكة طاقة هجينة",
    motorsport: "رسم توضيحي لبيانات مجموعة نقل الحركة"
  },
  ru: {
    astronomy: "Концептуальный график астрономической кривой блеска",
    aerospace: "Концептуальное поле потока вокруг профиля крыла",
    "remote-sensing": "Концептуальные слои данных дистанционного зондирования",
    "artificial-intelligence": "Концептуальная схема сети машинного обучения",
    energy: "Концептуальная схема гибридной микросети",
    motorsport: "Концептуальный график телеметрии силовой установки"
  },
  de: {
    astronomy: "Konzeptionelle Analyse einer astronomischen Lichtkurve",
    aerospace: "Konzeptionelles Strömungsfeld um ein Flügelprofil",
    "remote-sensing": "Konzeptionelle Erdbeobachtungs-Datenebenen",
    "artificial-intelligence": "Konzeptionelles Netzwerk für maschinelles Lernen",
    energy: "Konzeptionelles hybrides Mikronetz",
    motorsport: "Konzeptionelles Telemetriediagramm des Antriebsstrangs"
  },
  zh: {
    astronomy: "天文光变曲线分析示意图",
    aerospace: "翼型周围流场示意图",
    "remote-sensing": "地球观测数据图层示意图",
    "artificial-intelligence": "机器学习网络示意图",
    energy: "混合微电网示意图",
    motorsport: "动力系统遥测图示"
  },
  fr: {
    astronomy: "Analyse conceptuelle d’une courbe de lumière astronomique",
    aerospace: "Champ d’écoulement conceptuel autour d’un profil d’aile",
    "remote-sensing": "Couches conceptuelles de données d’observation de la Terre",
    "artificial-intelligence": "Réseau conceptuel d’apprentissage automatique",
    energy: "Micro-réseau hybride conceptuel",
    motorsport: "Graphique conceptuel de télémétrie du groupe motopropulseur"
  },
  es: {
    astronomy: "Análisis conceptual de una curva de luz astronómica",
    aerospace: "Campo de flujo conceptual alrededor de un perfil alar",
    "remote-sensing": "Capas conceptuales de datos de observación terrestre",
    "artificial-intelligence": "Red conceptual de aprendizaje automático",
    energy: "Microrred híbrida conceptual",
    motorsport: "Gráfico conceptual de telemetría del tren motriz"
  }
};
const title = `${field.title} — ${site.companyName}`;
---
<SiteLayout locale={locale} title={title} description={detail.problem}>
  <div class="site-shell domain-detail-page domain-detail-page--deep">
    <section class="hero domain-hero domain-hero--deep" aria-labelledby="field-title" style={`--domain-image: url(${domainImageUrl(field.slug)})`}>
      <div class="domain-hero-copy">
        <p class="eyebrow">{site.navigation.fields}</p>
        <h1 id="field-title">{field.title}</h1>
        <p class="domain-kicker">{detail.kicker}</p>
        <p class="lede">{field.summary}</p>
      </div>
      <figure class="domain-technical-figure">
        <img src={domainDiagramUrl(field.slug)} alt={diagramAlt[locale][field.slug]} width="900" height="560" loading="eager" decoding="async" />
      </figure>
    </section>

    <section class="domain-deep-section domain-problem-section" aria-labelledby="domain-problem-title">
      <div class="domain-section-heading">
        <p class="eyebrow">{labels.overview}</p>
        <h2 id="domain-problem-title">{detail.problemTitle}</h2>
      </div>
      <p class="domain-lead-copy">{detail.problem}</p>
    </section>

    <section class="domain-deep-section" aria-labelledby="domain-science-title">
      <div class="domain-section-heading">
        <p class="eyebrow">{labels.science}</p>
        <h2 id="domain-science-title">{labels.science}</h2>
      </div>
      <div class="domain-knowledge-grid">
        {detail.science.map((item, index) => (
          <article class="domain-knowledge-card">
            <span class="domain-card-index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="domain-deep-section" aria-labelledby="domain-capabilities-title">
      <div class="domain-section-heading">
        <p class="eyebrow">{labels.capabilities}</p>
        <h2 id="domain-capabilities-title">{labels.capabilities}</h2>
      </div>
      <div class="domain-capability-grid">
        {detail.capabilities.map((item) => (
          <article class="domain-capability-item">
            <span class="domain-capability-mark" aria-hidden="true"></span>
            <div><h3>{item.title}</h3><p>{item.body}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="domain-deep-section domain-workflow-section" aria-labelledby="domain-workflow-title">
      <div class="domain-section-heading">
        <p class="eyebrow">{labels.workflow}</p>
        <h2 id="domain-workflow-title">{detail.workflowTitle}</h2>
      </div>
      <ol class="domain-workflow">
        {detail.workflow.map((step) => (
          <li><h3>{step.title}</h3><p>{step.body}</p></li>
        ))}
      </ol>
    </section>

    <section class="domain-deep-section domain-validation-grid">
      <article aria-labelledby="domain-validation-title">
        <p class="eyebrow">{labels.validation}</p>
        <h2 id="domain-validation-title">{labels.validation}</h2>
        <p>{detail.validation}</p>
      </article>
      <article aria-labelledby="domain-limits-title">
        <p class="eyebrow">{labels.limits}</p>
        <h2 id="domain-limits-title">{labels.limits}</h2>
        <p>{detail.limits}</p>
      </article>
    </section>

    <section class="domain-deep-section domain-links-section" aria-labelledby="domain-links-title">
      <div class="domain-section-heading">
        <p class="eyebrow">{labels.links}</p>
        <h2 id="domain-links-title">{labels.links}</h2>
      </div>
      <ul class="domain-link-list">{detail.links.map((item) => <li>{item}</li>)}</ul>
    </section>

    <section class="domain-deep-section" aria-labelledby="domain-work-title">
      <div class="domain-section-heading">
        <p class="eyebrow">{labels.work}</p>
        <h2 id="domain-work-title">{detail.workTitle}</h2>
      </div>
      <div class="domain-work-grid">
        {detail.work.map((item) => (
          <article class="domain-work-card">
            <span class:list={["domain-work-kind", item.kind === "documented" ? "is-documented" : "is-focus"]}>
              {item.kind === "documented" ? labels.documented : labels.focus}
            </span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <p class="domain-work-status">{item.status}</p>
          </article>
        ))}
      </div>
    </section>

  </div>
</SiteLayout>
