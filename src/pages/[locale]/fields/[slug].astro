---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { locales, type Locale } from "../../../data/locales";
import { content } from "../../../content/site";
import { domainImageUrl } from "../../../data/domain-assets";
import { domainPortfolio, domainPortfolioLabels } from "../../../content/domain-projects";
import { domainDeepDiveFa } from "../../../content/domain-deep-dive.fa";

export function getStaticPaths() {
  return locales.flatMap((locale) => content[locale].fields.map((field) => ({
    params: { locale, slug: field.slug }, props: { locale, field }
  })));
}
const { locale, field } = Astro.props as { locale: Locale; field: (typeof content.en.fields)[number] };
const site = content[locale];
const portfolio = domainPortfolio[locale][field.slug];
const portfolioLabels = domainPortfolioLabels[locale];
const deepDive = locale === "fa" ? domainDeepDiveFa[field.slug] : undefined;
const labels: Record<Locale, { scope: string; work: string; empty: string; approach: string; note: string; roadmap: string }> = {
  fa: { scope: "روش‌ها، فناوری‌ها و دامنه تخصصی", work: "سوابق و پروژه‌های مرتبط", empty: "در حال حاضر پروژه عمومی و مستندی برای نمایش در این حوزه معرفی نشده است.", approach: "رویکرد توسعه", note: "این صفحه زمینه‌های تخصصی و دامنه مورد توجه شرکت را معرفی می‌کند. ذکر یک توانمندی به‌تنهایی به معنی ارائه مستمر آن به‌عنوان خدمت تجاری یا تکمیل همه فناوری‌های مرتبط نیست. دامنه هر پروژه پس از بررسی نیاز، امکان‌سنجی فنی و منابع در دسترس تعیین می‌شود.", roadmap: "این حوزه در نقشه راه توسعه شرکت قرار دارد و افزودن رسمی آن به موضوع فعالیت اساسنامه در دست پیگیری است." },
  en: { scope: "Methods, technologies and specialist scope", work: "Related documented work", empty: "No public, documented project is currently listed for this domain.", approach: "Development approach", note: "This page describes the company's areas of focus and technical scope. A listed capability does not, by itself, mean that it is continuously offered as a commercial service or that every related technology is complete. Each project is scoped after requirements review, technical feasibility assessment, and resource evaluation.", roadmap: "This domain is part of the company's development roadmap. Its formal addition to the registered business scope is being pursued." },
  ar: { scope: "الأساليب والتقنيات والنطاق التخصصي", work: "الأعمال والمشاريع الموثقة ذات الصلة", empty: "لا يوجد حالياً مشروع عام موثق مُدرج لهذا المجال.", approach: "منهج التطوير", note: "تعرض هذه الصفحة مجالات اهتمام الشركة ونطاقها التقني. ولا يعني إدراج قدرة معينة أنها تُقدم باستمرار كخدمة تجارية أو أن جميع التقنيات المرتبطة بها قد اكتملت. ويُحدد نطاق كل مشروع بعد مراجعة المتطلبات وتقييم الجدوى الفنية والموارد المتاحة.", roadmap: "هذا المجال جزء من خارطة تطوير الشركة، ويجري العمل على إضافته رسمياً إلى نطاق النشاط المسجل." },
  ru: { scope: "Методы, технологии и профильные компетенции", work: "Связанные документированные проекты", empty: "Для этого направления пока не указан публичный документированный проект.", approach: "Подход к развитию", note: "На этой странице представлены области интересов и техническая сфера компании. Указанная компетенция сама по себе не означает, что услуга постоянно предоставляется на коммерческой основе или что все связанные технологии завершены. Объём каждого проекта определяется после анализа требований, технической осуществимости и доступных ресурсов.", roadmap: "Это направление включено в дорожную карту развития компании; ведётся работа над его официальным включением в зарегистрированный перечень видов деятельности." },
  de: { scope: "Methoden, Technologien und fachlicher Umfang", work: "Zugehörige dokumentierte Projekte", empty: "Für diesen Bereich ist derzeit kein öffentliches, dokumentiertes Projekt aufgeführt.", approach: "Entwicklungsansatz", note: "Diese Seite beschreibt die Interessengebiete und den technischen Umfang des Unternehmens. Eine aufgeführte Kompetenz bedeutet nicht automatisch, dass sie kontinuierlich als kommerzielle Dienstleistung angeboten wird oder dass alle zugehörigen Technologien abgeschlossen sind. Der Umfang jedes Projekts wird nach Anforderungsprüfung, Machbarkeitsbewertung und Prüfung der verfügbaren Ressourcen festgelegt.", roadmap: "Dieser Bereich ist Teil der Entwicklungsroadmap. Die formelle Aufnahme in den eingetragenen Unternehmensgegenstand wird verfolgt." },
  zh: { scope: "方法、技术与专业范围", work: "相关的已记录项目", empty: "目前尚未列出该领域的公开、可核实项目。", approach: "发展方式", note: "本页面介绍公司的关注领域和技术范围。列出某项能力并不表示公司持续以商业服务形式提供该能力，也不表示相关技术均已完成。每个项目的范围将在需求审查、技术可行性评估和资源评估后确定。", roadmap: "该领域已纳入公司的发展路线图，正在推进将其正式加入注册经营范围。" },
  fr: { scope: "Méthodes, technologies et périmètre spécialisé", work: "Projets documentés associés", empty: "Aucun projet public et documenté n’est actuellement répertorié pour ce domaine.", approach: "Approche de développement", note: "Cette page présente les domaines d’intérêt et le périmètre technique de l’entreprise. La mention d’une compétence ne signifie pas qu’elle est proposée en continu comme service commercial ni que toutes les technologies associées sont achevées. Le périmètre de chaque projet est défini après examen des besoins, évaluation de la faisabilité technique et analyse des ressources.", roadmap: "Ce domaine figure dans la feuille de route de développement. Son ajout officiel au champ d’activité enregistré est en cours." },
  es: { scope: "Métodos, tecnologías y alcance especializado", work: "Proyectos documentados relacionados", empty: "Actualmente no hay ningún proyecto público y documentado listado para esta área.", approach: "Enfoque de desarrollo", note: "Esta página describe las áreas de interés y el alcance técnico de la empresa. La inclusión de una capacidad no significa que se ofrezca continuamente como servicio comercial ni que todas las tecnologías relacionadas estén terminadas. El alcance de cada proyecto se define tras revisar los requisitos, evaluar la viabilidad técnica y analizar los recursos disponibles.", roadmap: "Esta área forma parte de la hoja de ruta de desarrollo. Se está tramitando su incorporación formal al objeto social registrado." }
};

const applicationTitle: Record<Locale, string> = { fa: "زمینه‌های کاربرد", en: "Application areas", ar: "مجالات التطبيق", ru: "Области применения", de: "Anwendungsbereiche", zh: "应用领域", fr: "Domaines d’application", es: "Áreas de aplicación" };
const applications: Record<Locale, Record<string, string>> = {
  fa: { astronomy: "پژوهش نجومی، رصد اپتیکی و رادیویی، تحلیل داده‌های نجومی و آموزش تخصصی", aerospace: "مأموریت‌های سنجشی و ارتباطی، سامانه‌های ماهواره‌ای، پهپادها و فناوری‌های پیشرانش", "remote-sensing": "مشاهده زمین، پایش محیطی، تحلیل تصاویر ماهواره‌ای و کشاورزی دقیق", energy: "تولید برق خورشیدی و بادی، سامانه‌های هیبریدی و پشتیبانی فنی صنایع انرژی", "artificial-intelligence": "مدیریت هوشمند، شهر هوشمند، اینترنت اشیا و کاربردهای هوش مصنوعی در حوزه‌های شرکت", motorsport: "مهندسی آیرودینامیک خودرو، قطعات مکانیکی پرفورمنس و اجزای توربوشارژر" },
  en: { astronomy: "Astronomical research, optical and radio observation, astronomical data analysis, and specialist training", aerospace: "Sensing and communication missions, satellite systems, UAVs, and propulsion technologies", "remote-sensing": "Earth observation, environmental monitoring, satellite-image analysis, and precision agriculture", energy: "Solar and wind electricity generation, hybrid systems, and technical support for energy industries", "artificial-intelligence": "Smart management, smart cities, IoT, and AI applications across the company's domains", motorsport: "Vehicle aerodynamics, mechanical performance components, and turbocharger components" },
  ar: { astronomy: "البحوث الفلكية والرصد البصري والراديوي وتحليل البيانات الفلكية والتدريب المتخصص", aerospace: "مهام الاستشعار والاتصالات والأنظمة الساتلية والطائرات دون طيار وتقنيات الدفع", "remote-sensing": "رصد الأرض والمراقبة البيئية وتحليل صور الأقمار الصناعية والزراعة الدقيقة", energy: "توليد الكهرباء بالطاقة الشمسية والرياح والأنظمة الهجينة والدعم الفني لصناعات الطاقة", "artificial-intelligence": "الإدارة الذكية والمدن الذكية وإنترنت الأشياء وتطبيقات الذكاء الاصطناعي في مجالات الشركة", motorsport: "الديناميكا الهوائية للمركبات ومكونات الأداء الميكانيكية وأجزاء الشواحن التوربينية" },
  ru: { astronomy: "Астрономические исследования, оптические и радионаблюдения, анализ астрономических данных и специализированное обучение", aerospace: "Зондирующие и коммуникационные миссии, спутниковые системы, БПЛА и двигательные технологии", "remote-sensing": "Наблюдение Земли, экологический мониторинг, анализ спутниковых изображений и точное земледелие", energy: "Солнечная и ветровая генерация электроэнергии, гибридные системы и техническая поддержка энергетики", "artificial-intelligence": "Интеллектуальное управление, умные города, IoT и применение ИИ в направлениях компании", motorsport: "Автомобильная аэродинамика, механические компоненты Performance и детали турбокомпрессоров" },
  de: { astronomy: "Astronomische Forschung, optische und Radio-Beobachtung, astronomische Datenanalyse und Fachschulungen", aerospace: "Fernerkundungs- und Kommunikationsmissionen, Satellitensysteme, UAVs und Antriebstechnologien", "remote-sensing": "Erdbeobachtung, Umweltmonitoring, Satellitenbildanalyse und Präzisionslandwirtschaft", energy: "Solar- und Windstromerzeugung, Hybridsysteme und technische Unterstützung der Energieindustrie", "artificial-intelligence": "Intelligentes Management, Smart Cities, IoT und KI-Anwendungen in den Unternehmensbereichen", motorsport: "Fahrzeugaerodynamik, mechanische Performance-Komponenten und Turboladerteile" },
  zh: { astronomy: "天文学研究、光学与射电观测、天文数据分析及专业培训", aerospace: "遥感与通信任务、卫星系统、无人机及推进技术", "remote-sensing": "地球观测、环境监测、卫星影像分析与精准农业", energy: "太阳能与风能发电、混合能源系统及能源行业技术支持", "artificial-intelligence": "智能管理、智慧城市、物联网以及人工智能在公司各领域的应用", motorsport: "车辆空气动力学、机械高性能部件及涡轮增压器部件" },
  fr: { astronomy: "Recherche astronomique, observation optique et radio, analyse de données astronomiques et formation spécialisée", aerospace: "Missions de télédétection et de communication, systèmes satellitaires, drones et technologies de propulsion", "remote-sensing": "Observation de la Terre, surveillance environnementale, analyse d’images satellitaires et agriculture de précision", energy: "Production solaire et éolienne, systèmes hybrides et assistance technique aux industries de l’énergie", "artificial-intelligence": "Gestion intelligente, villes intelligentes, IoT et applications de l’IA dans les domaines de l’entreprise", motorsport: "Aérodynamique automobile, composants mécaniques de performance et pièces de turbocompresseurs" },
  es: { astronomy: "Investigación astronómica, observación óptica y de radio, análisis de datos astronómicos y formación especializada", aerospace: "Misiones de observación y comunicación, sistemas satelitales, UAV y tecnologías de propulsión", "remote-sensing": "Observación de la Tierra, vigilancia ambiental, análisis de imágenes satelitales y agricultura de precisión", energy: "Generación solar y eólica, sistemas híbridos y apoyo técnico a las industrias energéticas", "artificial-intelligence": "Gestión inteligente, ciudades inteligentes, IoT y aplicaciones de IA en las áreas de la empresa", motorsport: "Aerodinámica de vehículos, componentes mecánicos de alto rendimiento y piezas de turbocompresores" }
};

const pageLabels = labels[locale];
---
<SiteLayout locale={locale} title={field.title + " — " + site.companyName} description={field.summary}>
  <div class="site-shell domain-detail-page">
    <section class="hero domain-hero" aria-labelledby="field-title" style={`--domain-image: url(${domainImageUrl(field.slug)})`}>
      <p class="eyebrow">{site.navigation.fields}</p><h1 id="field-title">{field.title}</h1><p class="lede">{field.summary}</p>
    </section>
    <section class="domain-content-section" aria-labelledby="capabilities-title">
      <div class="section-heading"><h2 id="capabilities-title">{pageLabels.scope}</h2></div>
      <ul class="capability-list domain-detail-list">{field.capabilities.map((item) => <li>{item}</li>)}</ul>
    </section>
    <section class="domain-content-section" aria-labelledby="applications-title">
      <div class="section-heading"><h2 id="applications-title">{applicationTitle[locale]}</h2></div>
      <p class="domain-applications">{applications[locale][field.slug]}</p>
    </section>
    <section class="domain-content-section" aria-labelledby="domain-introduction-title">
      <div class="section-heading"><h2 id="domain-introduction-title">{portfolioLabels.introduction}</h2></div>
      <p class="domain-applications">{portfolio.introduction}</p>
    </section>
    {deepDive && <section class="domain-deep-dive" aria-labelledby="deep-dive-title">
      <div class="section-heading"><div><p class="eyebrow">ENGINEERING PERSPECTIVE</p><h2 id="deep-dive-title">نگاه علمی و مهندسی</h2></div><p class="lede">از مبانی علمی تا فرایند تحلیل، اعتبارسنجی و محدودیت‌های فنی</p></div>
      <p class="domain-deep-lead">{deepDive.lead}</p>
      <div class="domain-science-grid">
        {deepDive.science.map((item, index) => <article class="domain-science-card">
          <span class="domain-science-index">{String(index + 1).padStart(2, "0")}</span>
          <h3>{item.title}</h3><p>{item.body}</p>
        </article>)}
      </div>
      <div class="domain-workflow">
        <div><p class="eyebrow">ENGINEERING WORKFLOW</p><h3>چرخه کار مهندسی</h3></div>
        <ol>{deepDive.workflow.map((step) => <li>{step}</li>)}</ol>
      </div>
      <div class="domain-review-grid">
        <article><h3>اعتبارسنجی و کنترل کیفیت</h3><p>{deepDive.validation}</p></article>
        <article><h3>مرز اطلاعات عمومی</h3><p>{deepDive.boundaries}</p></article>
      </div>
      <div class="domain-visual-brief">
        <div><p class="eyebrow">VISUAL CONTENT PLAN</p><h3>تصاویر و نمودارهای پیشنهادی</h3></div>
        <div class="domain-visual-grid">{deepDive.visualBrief.map((item, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><div><h4>{item.title}</h4><p>{item.description}</p></div></article>)}</div>
      </div>
    </section>}
    <section class="domain-content-section" aria-labelledby="related-title">
      <div class="section-heading"><h2 id="related-title">{portfolioLabels.projects}</h2></div>
      <div class="project-grid">{portfolio.projects.map((project) => <article class="project-card"><h3>{project.title}</h3><p>{project.summary}</p><details class="domain-project-details"><summary>{locale === "fa" ? "جزئیات" : "Details"}</summary><p>{project.overview}</p></details></article>)}</div>
    </section>
    <section class="domain-development domain-content-section" aria-labelledby="development-title">
      <div class="section-heading"><h2 id="development-title">{pageLabels.approach}</h2></div>
      <p>{pageLabels.note}</p>
      {field.slug === "motorsport" && <p class="domain-roadmap-note">{pageLabels.roadmap}</p>}
    </section>
  </div>
  <style>
    .domain-deep-dive{padding:clamp(2.5rem,6vw,5rem) 0;border-top:1px solid var(--border)}
    .domain-deep-dive .section-heading{align-items:end}
    .domain-deep-dive .section-heading h2{font-size:clamp(1.8rem,3.5vw,3rem);margin:0}
    .domain-deep-dive .eyebrow{font-size:.68rem}
    .domain-deep-lead{max-width:88ch;margin:0 0 2rem;font-size:clamp(1.05rem,1.6vw,1.2rem);line-height:2.15;color:var(--ink)}
    .domain-science-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
    .domain-science-card,.domain-review-grid article{padding:1.5rem;border:1px solid var(--border);border-radius:1rem;background:var(--surface-2)}
    .domain-science-index,.domain-visual-grid article>span{font-size:.72rem;font-weight:850;letter-spacing:.12em;color:var(--accent)}
    .domain-science-card h3,.domain-review-grid h3,.domain-workflow h3,.domain-visual-brief h3{margin:.6rem 0 1rem;font-size:1.18rem;line-height:1.5}
    .domain-science-card p,.domain-review-grid p,.domain-visual-grid p{margin:0;color:var(--muted);line-height:2}
    .domain-workflow{display:grid;grid-template-columns:.65fr 1.35fr;gap:2rem;margin:2rem 0;padding:2rem;border:1px solid var(--border);border-radius:1rem;background:linear-gradient(135deg,var(--surface-2),var(--surface))}
    .domain-workflow h3,.domain-visual-brief h3{margin-top:0}
    .domain-workflow ol{display:grid;gap:.65rem;margin:0;padding-inline-start:1.5rem}
    .domain-workflow li{padding:.35rem .25rem;line-height:1.8}
    .domain-review-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
    .domain-visual-brief{margin-top:2rem;padding:2rem;border:1px solid var(--border);border-radius:1rem}
    .domain-visual-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
    .domain-visual-grid article{display:flex;gap:.85rem;align-items:flex-start;padding-top:1rem;border-top:1px solid var(--border)}
    .domain-visual-grid h4{margin:0 0 .45rem;font-size:1rem;line-height:1.5}
    @media(max-width:760px){.domain-science-grid,.domain-review-grid,.domain-visual-grid{grid-template-columns:1fr}.domain-workflow{grid-template-columns:1fr;gap:.5rem;padding:1.25rem}.domain-visual-brief{padding:1.25rem}.domain-science-card{padding:1.25rem}}
  </style>
</SiteLayout>
