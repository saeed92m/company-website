---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { locales, type Locale } from "../../../data/locales";
import { content } from "../../../content/site";
import { domainImageUrl } from "../../../data/domain-assets";
import { ceo } from "../../../content/ceo";

export function getStaticPaths() {
  return locales.flatMap((locale) => content[locale].fields.map((field) => ({
    params: { locale, slug: field.slug }, props: { locale, field }
  })));
}
const { locale, field } = Astro.props as { locale: Locale; field: (typeof content.en.fields)[number] };
const site = content[locale];
const profile = ceo[locale];
const terms: Record<string, string[]> = { astronomy: ["CBS", "APTO"], aerospace: ["CanSat", "CubeSat"], "remote-sensing": ["Remote Sensing"], energy: [], "artificial-intelligence": [], motorsport: [] };
const related = profile.selectedProjects.filter((project) => (terms[field.slug] ?? []).some((term) => project.name.toLowerCase().includes(term.toLowerCase())));
const labels: Record<Locale, { scope: string; work: string; empty: string; approach: string; note: string; roadmap: string }> = {
  fa: { scope: "دامنه تخصصی و توانمندی‌ها", work: "سوابق و پروژه‌های مرتبط", empty: "در حال حاضر پروژه عمومی و مستندی برای نمایش در این حوزه معرفی نشده است.", approach: "رویکرد توسعه", note: "این صفحه زمینه‌های تخصصی و دامنه مورد توجه شرکت را معرفی می‌کند. ذکر یک توانمندی به‌تنهایی به معنی ارائه مستمر آن به‌عنوان خدمت تجاری یا تکمیل همه فناوری‌های مرتبط نیست. دامنه هر پروژه پس از بررسی نیاز، امکان‌سنجی فنی و منابع در دسترس تعیین می‌شود.", roadmap: "این حوزه در نقشه راه توسعه شرکت قرار دارد و افزودن رسمی آن به موضوع فعالیت اساسنامه در دست پیگیری است." },
  en: { scope: "Specialist scope and capabilities", work: "Related documented work", empty: "No public, documented project is currently listed for this domain.", approach: "Development approach", note: "This page describes the company's areas of focus and technical scope. A listed capability does not, by itself, mean that it is continuously offered as a commercial service or that every related technology is complete. Each project is scoped after requirements review, technical feasibility assessment, and resource evaluation.", roadmap: "This domain is part of the company's development roadmap. Its formal addition to the registered business scope is being pursued." },
  ar: { scope: "النطاق التخصصي والقدرات", work: "الأعمال والمشاريع الموثقة ذات الصلة", empty: "لا يوجد حالياً مشروع عام موثق مُدرج لهذا المجال.", approach: "منهج التطوير", note: "تعرض هذه الصفحة مجالات اهتمام الشركة ونطاقها التقني. ولا يعني إدراج قدرة معينة أنها تُقدم باستمرار كخدمة تجارية أو أن جميع التقنيات المرتبطة بها قد اكتملت. ويُحدد نطاق كل مشروع بعد مراجعة المتطلبات وتقييم الجدوى الفنية والموارد المتاحة.", roadmap: "هذا المجال جزء من خارطة تطوير الشركة، ويجري العمل على إضافته رسمياً إلى نطاق النشاط المسجل." },
  ru: { scope: "Специализация и технические возможности", work: "Связанные документированные проекты", empty: "Для этого направления пока не указан публичный документированный проект.", approach: "Подход к развитию", note: "На этой странице представлены области интересов и техническая сфера компании. Указанная компетенция сама по себе не означает, что услуга постоянно предоставляется на коммерческой основе или что все связанные технологии завершены. Объём каждого проекта определяется после анализа требований, технической осуществимости и доступных ресурсов.", roadmap: "Это направление включено в дорожную карту развития компании; ведётся работа над его официальным включением в зарегистрированный перечень видов деятельности." },
  de: { scope: "Fachlicher Umfang und Kompetenzen", work: "Zugehörige dokumentierte Projekte", empty: "Für diesen Bereich ist derzeit kein öffentliches, dokumentiertes Projekt aufgeführt.", approach: "Entwicklungsansatz", note: "Diese Seite beschreibt die Interessengebiete und den technischen Umfang des Unternehmens. Eine aufgeführte Kompetenz bedeutet nicht automatisch, dass sie kontinuierlich als kommerzielle Dienstleistung angeboten wird oder dass alle zugehörigen Technologien abgeschlossen sind. Der Umfang jedes Projekts wird nach Anforderungsprüfung, Machbarkeitsbewertung und Prüfung der verfügbaren Ressourcen festgelegt.", roadmap: "Dieser Bereich ist Teil der Entwicklungsroadmap. Die formelle Aufnahme in den eingetragenen Unternehmensgegenstand wird verfolgt." },
  zh: { scope: "专业范围与技术能力", work: "相关的已记录项目", empty: "目前尚未列出该领域的公开、可核实项目。", approach: "发展方式", note: "本页面介绍公司的关注领域和技术范围。列出某项能力并不表示公司持续以商业服务形式提供该能力，也不表示相关技术均已完成。每个项目的范围将在需求审查、技术可行性评估和资源评估后确定。", roadmap: "该领域已纳入公司的发展路线图，正在推进将其正式加入注册经营范围。" },
  fr: { scope: "Périmètre spécialisé et compétences", work: "Projets documentés associés", empty: "Aucun projet public et documenté n’est actuellement répertorié pour ce domaine.", approach: "Approche de développement", note: "Cette page présente les domaines d’intérêt et le périmètre technique de l’entreprise. La mention d’une compétence ne signifie pas qu’elle est proposée en continu comme service commercial ni que toutes les technologies associées sont achevées. Le périmètre de chaque projet est défini après examen des besoins, évaluation de la faisabilité technique et analyse des ressources.", roadmap: "Ce domaine figure dans la feuille de route de développement. Son ajout officiel au champ d’activité enregistré est en cours." },
  es: { scope: "Alcance especializado y capacidades", work: "Proyectos documentados relacionados", empty: "Actualmente no hay ningún proyecto público y documentado listado para esta área.", approach: "Enfoque de desarrollo", note: "Esta página describe las áreas de interés y el alcance técnico de la empresa. La inclusión de una capacidad no significa que se ofrezca continuamente como servicio comercial ni que todas las tecnologías relacionadas estén terminadas. El alcance de cada proyecto se define tras revisar los requisitos, evaluar la viabilidad técnica y analizar los recursos disponibles.", roadmap: "Esta área forma parte de la hoja de ruta de desarrollo. Se está tramitando su incorporación formal al objeto social registrado." }
};
const pageLabels = labels[locale];
---
<SiteLayout locale={locale} title={field.title + " — " + site.companyName} description={field.summary}>
  <div class="site-shell">
    <section class="hero domain-hero" aria-labelledby="field-title" style={`--domain-image: url(${domainImageUrl(field.slug)})`}>
      <p class="eyebrow">{site.navigation.fields}</p><h1 id="field-title">{field.title}</h1><p class="lede">{field.summary}</p>
    </section>
    <section aria-labelledby="capabilities-title">
      <div class="section-heading"><h2 id="capabilities-title">{pageLabels.scope}</h2></div>
      <ul class="capability-list domain-detail-list">{field.capabilities.map((item) => <li>{item}</li>)}</ul>
    </section>
    <section aria-labelledby="related-title">
      <div class="section-heading"><h2 id="related-title">{pageLabels.work}</h2></div>
      {related.length ? <div class="project-grid">{related.map((project) => <article class="project-card"><h3>{project.name}</h3><p>{project.period}</p><p>{project.summary}</p></article>)}</div> : <p class="domain-empty-note">{pageLabels.empty}</p>}
    </section>
    <section class="domain-development" aria-labelledby="development-title">
      <div class="section-heading"><h2 id="development-title">{pageLabels.approach}</h2></div>
      <p>{pageLabels.note}</p>
      {field.slug === "motorsport" && <p class="domain-roadmap-note">{pageLabels.roadmap}</p>}
    </section>
  </div>
</SiteLayout>
