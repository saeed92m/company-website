---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { locales, type Locale } from "../../../data/locales";
import { ceo } from "../../../content/ceo";
import { content as siteContent } from "../../../content/site";
import { ui } from "../../../content/ui";
import { publications } from "../../../content/publications";
import { ceoAdditional } from "../../../content/ceo-additional";
import { formatPeriod } from "../../../utils/date-format";
import BrandMark from "../../../components/BrandMark.astro";
const assetBase = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
const profile = ceo[locale];
const site = siteContent[locale];
const labels = ui[locale];
const profilePublications = publications[locale];
const additional = ceoAdditional[locale];
---
<SiteLayout locale={locale} title={profile.name + " — " + site.companyName} description={profile.summary}>
  <div class="site-shell">
    <section class="hero hero-brand hero-profile" aria-labelledby="ceo-title">
      <div class="hero-copy">
        <p class="eyebrow">{site.navigation.company}</p>
        <h1 id="ceo-title">{profile.name}</h1>
        <p class="lede">{profile.role}</p>
        <p>{profile.summary}</p>
      </div>
      <div class="hero-mark" aria-hidden="true"><BrandMark label="ALPHA TEAM" /></div>
    </section>
    <section aria-labelledby="education-title">
      <div class="section-heading"><h2 id="education-title">{labels.education}</h2></div>
      <div class="project-grid">
        {profile.education.map((item) => <article class="project-card"><h3>{item.degree}</h3><p>{item.field}</p><p>{item.institution} · {formatPeriod(item.years, locale)}</p></article>)}
      </div>
    </section>
    <section aria-labelledby="expertise-title">
      <div class="section-heading"><h2 id="expertise-title">{labels.expertise}</h2></div>
      <ul class="capability-list">{profile.expertise.map((item) => <li>{item}</li>)}</ul>
    </section>
    <section aria-labelledby="experience-title">
      <div class="section-heading"><h2 id="experience-title">{labels.experience}</h2></div>
      <div class="project-grid">
        {profile.experience.map((item) => <article class="project-card"><h3>{item.role}</h3><p><strong>{item.organization}</strong> · {item.period}</p><p>{item.summary}</p></article>)}
      </div>
    </section>
    <section aria-labelledby="projects-title">
      <div class="section-heading"><h2 id="projects-title">{labels.selectedProjects}</h2></div>
      <div class="project-grid">
        {profile.selectedProjects.map((item) => <article class="project-card"><h3>{item.name}</h3><p>{formatPeriod(item.period, locale)}</p><p>{item.summary}</p></article>)}
      </div>
    </section>
    <section aria-labelledby="skills-title">
      <div class="section-heading"><h2 id="skills-title">{labels.skills}</h2></div>
      <ul class="capability-list">{additional.skills.map((item) => <li>{item}</li>)}</ul>
    </section>
    <section aria-labelledby="languages-title">
      <div class="section-heading"><h2 id="languages-title">{labels.languages}</h2></div>
      <ul class="capability-list">{additional.languages.map((item) => <li>{item}</li>)}</ul>
    </section>
    <section aria-labelledby="memberships-title">
      <div class="section-heading"><h2 id="memberships-title">{labels.memberships}</h2></div>
      <ul class="capability-list">{additional.memberships.map((item) => <li>{formatPeriod(item, locale)}</li>)}</ul>
    </section>
    <section aria-labelledby="courses-title">
      <div class="section-heading"><h2 id="courses-title">{labels.courses}</h2></div>
      <ul class="capability-list">{additional.courses.map((item) => <li>{item}</li>)}</ul>
    </section>
    <section aria-labelledby="publications-title">
      <div class="section-heading"><h2 id="publications-title">{labels.publications}</h2></div>
      <div class="project-grid">
        {profilePublications.map((item, index) => <article class="project-card"><h3>{item.title}</h3><p>{item.venue} · {formatPeriod(item.period, locale)}</p><p>{item.authors}</p><div class="card-actions"><button class="button button-secondary" type="button" aria-label={labels.summaryPublication} data-publication-summary={index}>{labels.summaryPublication}</button><a class="button button-primary" href={item.url} target="_blank" rel="noopener noreferrer">{labels.viewPublication}</a></div><dialog class="publication-dialog" dir={locale === "fa" || locale === "ar" ? "rtl" : "ltr"} data-publication-dialog={index} aria-labelledby={"publication-title-" + index}><div class="publication-dialog__panel"><button class="publication-dialog__close" type="button" data-publication-close={index} aria-label={labels.close}>×</button><h3 id={"publication-title-" + index}>{item.title}</h3><p class="publication-dialog__label">{labels.summaryPublication}</p><p>{item.abstract}</p><a class="button button-primary" href={item.downloadUrl} target="_blank" rel="noopener noreferrer">{labels.downloadPublication}</a></div></dialog></article>)}
      </div>
    </section>
  </div>
</SiteLayout>

<script>
  const summaryButtons = document.querySelectorAll("[data-publication-summary]");
  summaryButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const index = button.getAttribute("data-publication-summary");
      const dialog = document.querySelector('[data-publication-dialog="' + index + '"]');
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });
  document.querySelectorAll("[data-publication-close]").forEach((button) => {
    button.addEventListener("click", () => {
      const index = button.getAttribute("data-publication-close");
      const dialog = document.querySelector('[data-publication-dialog="' + index + '"]');
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });
  });
  document.querySelectorAll(".publication-dialog").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
    });
  });
</script>
