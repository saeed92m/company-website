---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { locales, type Locale } from "../../../data/locales";
import { content } from "../../../content/site";
import { corporateCopy } from "../../../content/corporate-copy";
import { ui } from "../../../content/ui";
import { route } from "../../../data/routes";
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale };
const site = content[locale]; const labels = ui[locale];
const copy = corporateCopy[locale];
const legalNameParts = site.companyName.match(/^(.*?)(\s*\([^)]*\))$/);
const roadmapNote: Record<Locale, string> = {
  fa: "موتوراسپرت و قطعات پرفورمنس در نقشه راه توسعه شرکت قرار دارد و افزودن رسمی آن به اساسنامه در دست پیگیری است.",
  en: "Motorsport and performance parts are on the company's development roadmap; formal addition to the articles of association is being pursued.",
  ar: "تقع رياضة المحركات وقطع الأداء ضمن خارطة تطوير الشركة، ويجري العمل على إضافتها رسميًا إلى النظام الأساسي.",
  ru: "Автоспорт и высокопроизводительные компоненты входят в дорожную карту развития компании; их официальное включение в устав находится в работе.",
  de: "Motorsport und Performance-Teile sind Teil der Entwicklungsroadmap des Unternehmens; ihre formelle Aufnahme in die Satzung wird verfolgt.",
  zh: "赛车运动及高性能零部件属于公司的发展路线图，正在推进将其正式纳入公司章程。",
  fr: "Le sport automobile et les pièces de performance font partie de la feuille de route de développement ; leur ajout officiel aux statuts est en cours.",
  es: "El automovilismo y las piezas de alto rendimiento forman parte de la hoja de ruta de desarrollo; su incorporación formal a los estatutos está en curso."
};
const registrationFact: Record<Locale, string> = {
  fa: "تاریخ تأسیس: مرداد ۱۴۰۲ · آگهی تأسیس روزنامهٔ رسمی: ۱۴۰۲/۰۵/۰۷",
  en: "Founded: August 2023 · Official Gazette notice: 29 July 2023",
  ar: "تأسست في أغسطس 2023 · إعلان الجريدة الرسمية: 29 يوليو 2023",
  ru: "Основана в августе 2023 года · публикация в официальном вестнике: 29 июля 2023 года",
  de: "Gegründet im August 2023 · Bekanntmachung im Amtsblatt: 29. Juli 2023",
  zh: "成立于 2023 年 8 月 · 官方公报公告日期：2023 年 7 月 29 日",
  fr: "Fondée en août 2023 · avis au Journal officiel : 29 juillet 2023",
  es: "Fundada en agosto de 2023 · anuncio en el Boletín Oficial: 29 de julio de 2023"
};
---
<SiteLayout locale={locale} title={site.navigation.company + " — " + site.companyName} description={copy.companyOverview.join(" ")}>
  <div class="site-shell">
    <section class={`hero company-hero${locale === "fa" ? " company-hero--image" : ""}`} aria-labelledby="company-title" style={locale === "fa" ? `--company-overview-image: url("${import.meta.env.BASE_URL}assets/domains/six-domains-overview.webp")` : undefined}>
      <p class="eyebrow">{site.navigation.company}</p>
      <h1 class="company-title" id="company-title">
        <span>{legalNameParts?.[1] ?? site.companyName}</span>
        {legalNameParts && <small>{legalNameParts[2]}</small>}
      </h1>
      <div class="company-overview">
        {copy.companyOverview.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="company-registration-fact">{registrationFact[locale]}</p>
      <p class="company-roadmap-note">{roadmapNote[locale]}</p>
      <p>{site.founder}</p>
    </section>
    <section aria-labelledby="fields-title"><div class="section-heading"><p class="eyebrow">{site.navigation.fields}</p><h2 id="fields-title">{site.navigation.fields}</h2></div>
      <div class="domain-grid">{site.fields.map((field) => <a class="domain-card" href={route(locale,"fields/"+field.slug)}><span><strong>{field.title}</strong><span class="card-summary">{field.summary}</span></span><span aria-hidden="true">↗</span></a>)}</div>
    </section>
    <section class="split" aria-labelledby="ceo-title"><div><p class="eyebrow">{labels.ceo}</p><h2 id="ceo-title">{site.founder}</h2></div><a class="button button-secondary" href={route(locale,"company/ceo")}>{labels.view}</a></section>
  </div>
</SiteLayout>

<style>
  /* Page-scoped background for the Persian Company hero. Shared site chrome is unchanged. */
  .company-hero--image {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .company-hero--image::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: -1rem;
    background-image: var(--company-overview-image);
    background-position: center;
    background-size: cover;
    filter: blur(6px);
    opacity: .58;
    transform: scale(1.04);
    pointer-events: none;
  }

  .company-hero--image::after {
    content: "";
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(4, 12, 24, .94) 0%,
      rgba(4, 12, 24, .84) 58%,
      rgba(4, 12, 24, .72) 100%
    );
    pointer-events: none;
  }

  .company-hero--image > * {
    position: relative;
    z-index: 2;
  }

  :global(html[data-theme="light"]) .company-hero--image::before {
    opacity: .22;
    filter: blur(5px) saturate(.85);
  }

  :global(html[data-theme="light"]) .company-hero--image::after {
    background: linear-gradient(
      105deg,
      rgba(248, 250, 252, .94) 0%,
      rgba(248, 250, 252, .88) 58%,
      rgba(248, 250, 252, .80) 100%
    );
  }

  @media (max-width: 640px) {
    .company-hero--image::before {
      filter: blur(4px);
      opacity: .52;
    }

    .company-hero--image::after {
      background: linear-gradient(
        180deg,
        rgba(4, 12, 24, .94) 0%,
        rgba(4, 12, 24, .86) 55%,
        rgba(4, 12, 24, .78) 100%
      );
    }

    :global(html[data-theme="light"]) .company-hero--image::after {
      background: linear-gradient(
        180deg,
        rgba(248, 250, 252, .95) 0%,
        rgba(248, 250, 252, .90) 55%,
        rgba(248, 250, 252, .84) 100%
      );
    }
  }
</style>
