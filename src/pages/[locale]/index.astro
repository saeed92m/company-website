---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { locales, type Locale } from "../../data/locales";
import { content } from "../../content/site";
import { ui } from "../../content/ui";
import { route } from "../../data/routes";
import { domainImageBySlug } from "../../data/domain-assets";
import BrandMark from "../../components/BrandMark.astro";
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale };
const site = content[locale]; const labels = ui[locale];
---
<SiteLayout locale={locale} title={site.companyName} description={site.intro}>
  <div class="site-shell">
    <section class="hero hero-brand" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">ALPHA TEAM · {site.founded}</p>
        <h1 id="hero-title">{site.tagline}</h1>
        <p class="lede">{site.intro}</p>
        <p class="hero-identity">{site.founder}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={route(locale,"fields")}>{site.navigation.fields}</a>
          <a class="button button-secondary" href={route(locale,"company")}>{site.navigation.company}</a>
        </div>
      </div>
      <div class="hero-mark" aria-hidden="true">
        <BrandMark label="ALPHA TEAM" />
      </div>
    </section>
    <section id="fields" aria-labelledby="fields-title">
      <div class="section-heading"><p class="eyebrow">{site.navigation.fields}</p><h2 id="fields-title">{site.navigation.fields}</h2><p class="lede">{site.intro}</p></div>
      <div class="domain-grid">{site.fields.map((field) => <a class="domain-card" href={route(locale,"fields/"+field.slug)} style={`--domain-image: url(${import.meta.env.BASE_URL + domainImageBySlug[field.slug]})`}><span><strong>{field.title}</strong><span class="card-summary">{field.summary}</span></span><span aria-hidden="true">↗</span></a>)}</div>
    </section>
    <section id="projects" aria-labelledby="projects-title">
      <div class="section-heading"><p class="eyebrow">{site.navigation.projects}</p><h2 id="projects-title">{site.navigation.projects}</h2></div>
      <div class="project-grid">{site.projects.map((project) => <article class="project-card"><h3>{project.title}</h3><p>{project.summary}</p><a href={route(locale,"projects")}>{site.navigation.projects}</a></article>)}</div>
    </section>
    <section id="company" class="split" aria-labelledby="company-title">
      <div><p class="eyebrow">{site.navigation.company}</p><h2 id="company-title">{site.companyName}</h2></div><p>{site.intro}</p>
    </section>
    <section id="ceo" class="split" aria-labelledby="ceo-title">
      <div><p class="eyebrow">{site.navigation.ceo}</p><h2 id="ceo-title">{site.founder}</h2></div><p><a href={route(locale,"company/ceo")}>{site.navigation.ceo}</a></p>
    </section>
    <section id="contact" class="contact" aria-labelledby="contact-title">
      <p class="eyebrow">{site.navigation.contact}</p><h2 id="contact-title">{site.navigation.contact}</h2><p>{labels.contactPending}</p>
      <a class="button button-on-blue" href={route(locale,"contact")}>{site.navigation.contact}</a>
    </section>
  </div>
</SiteLayout>