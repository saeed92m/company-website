---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { locales, type Locale } from "../../data/locales";
import { content } from "../../content/site";
import { corporateCopy } from "../../content/corporate-copy";
import { ui } from "../../content/ui";
import { route } from "../../data/routes";
import { domainImageUrl } from "../../data/domain-assets";
import ProjectCards from "../../components/ProjectCards.astro";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
const site = content[locale];
const labels = ui[locale];
const copyContent = corporateCopy[locale];
const managementButton: Record<Locale, string> = { fa: "درباره مدیریت", en: "About management", ar: "عن الإدارة", ru: "О руководстве", de: "Über die Geschäftsführung", zh: "关于管理层", fr: "À propos de la direction", es: "Sobre la dirección" };

const visualLabels: Record<Locale, { explore: string; focus: string; overview: string }> = {
  fa: { explore: "مشاهدهٔ حوزه", focus: "پژوهش · مهندسی · توسعه", overview: "از پژوهش علمی تا راهکار مهندسی" },
  en: { explore: "Explore domain", focus: "RESEARCH · ENGINEERING · DEVELOPMENT", overview: "From scientific research to engineered solutions" },
  ar: { explore: "استكشف المجال", focus: "البحث · الهندسة · التطوير", overview: "من البحث العلمي إلى الحلول الهندسية" },
  ru: { explore: "Подробнее", focus: "ИССЛЕДОВАНИЯ · ИНЖЕНЕРИЯ · РАЗРАБОТКА", overview: "От научных исследований к инженерным решениям" },
  de: { explore: "Bereich ansehen", focus: "FORSCHUNG · ENGINEERING · ENTWICKLUNG", overview: "Von wissenschaftlicher Forschung zu technischen Lösungen" },
  zh: { explore: "了解领域", focus: "研究 · 工程 · 开发", overview: "从科学研究到工程解决方案" },
  fr: { explore: "Explorer", focus: "RECHERCHE · INGÉNIERIE · DÉVELOPPEMENT", overview: "De la recherche scientifique aux solutions d’ingénierie" },
  es: { explore: "Explorar área", focus: "INVESTIGACIÓN · INGENIERÍA · DESARROLLO", overview: "De la investigación científica a las soluciones de ingeniería" }
};
const copy = visualLabels[locale];
const baseDir = locale === "fa" || locale === "ar" ? "rtl" : "ltr";
---
<SiteLayout locale={locale} title={site.companyName} description={site.intro}>
  <div class="home-redesign" dir={baseDir}>
    <section class="new-hero site-shell" aria-labelledby="hero-title">
      <div class="new-hero-copy">
        <p class="new-kicker"><span class="kicker-rule"></span>{copy.focus}</p>
        <p class="new-company-name">{site.companyName}</p>
        <h1 id="hero-title">{site.tagline}</h1>
        <p class="new-hero-intro">{copyContent.homeHeroIntro}</p>
        <div class="new-hero-actions">
          <a class="new-button new-button-primary" href={route(locale,"fields")}>{site.navigation.fields}<span aria-hidden="true">↗</span></a>
          <a class="new-text-link" href={route(locale,"company")}>{site.navigation.company}<span aria-hidden="true">→</span></a>
        </div>
      </div>



    </section>

    <section class="new-domains" id="fields" aria-labelledby="fields-title">
      <div class="site-shell">
        <div class="new-section-head">
          <div><p class="new-kicker"><span class="kicker-rule"></span>01 / {site.navigation.fields}</p><h2 id="fields-title">{copy.overview}</h2></div>
          <p>{site.intro}</p>
        </div>
        <div class="new-domain-grid">
          {site.fields.map((field, index) => (
            <a class:list={["new-domain-card", index === 0 ? "domain-featured" : ""]} href={route(locale,"fields/"+field.slug)} style={`--domain-art: url("${domainImageUrl(field.slug)}")`}>
              <span class="domain-card-top"><span class="domain-number">0{index + 1}</span><span class="domain-arrow" aria-hidden="true">↗</span></span>
              <span class="domain-card-bottom"><strong>{field.title}</strong><span>{field.summary}</span><span class="domain-explore">{copy.explore} <span aria-hidden="true">→</span></span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="new-projects site-shell" id="projects" aria-labelledby="projects-title">
      <div class="new-section-head">
        <div><p class="new-kicker"><span class="kicker-rule"></span>02 / {site.navigation.projects}</p><h2 id="projects-title">{site.navigation.projects}</h2></div>
        <p>{site.intro}</p>
      </div>
      <ProjectCards locale={locale} projects={site.projects} labels={labels} />
    </section>

    <section class="new-company" id="company" aria-labelledby="company-title">
      <div class="site-shell new-company-inner">
        <div><p class="new-kicker"><span class="kicker-rule"></span>03 / {site.navigation.company}</p><h2 id="company-title">{site.companyName}</h2></div>
        <div class="new-company-detail"><p>{copyContent.companyOverview[0]}</p><p class="new-founder">{site.founder}</p><a class="new-button new-button-secondary management-button" href={route(locale,"company/ceo")}>{managementButton[locale]}<span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="new-contact site-shell" id="contact" aria-labelledby="contact-title">
      <div class="new-contact-panel">
        <div><p class="new-kicker"><span class="kicker-rule"></span>{site.navigation.contact}</p><h2 id="contact-title">{copy.overview}</h2><p>{labels.contactPending}</p></div>
        <a class="new-button new-button-light" href={route(locale,"contact")}>{site.navigation.contact}<span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</SiteLayout>
