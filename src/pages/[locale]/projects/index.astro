---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { locales, type Locale } from "../../../data/locales";
import { content } from "../../../content/site";
import { ui } from "../../../content/ui";
import ProjectCards from "../../../components/ProjectCards.astro";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
const site = content[locale];
const labels = ui[locale];
const projectsIntro: Record<Locale, string> = {
  fa: "در این بخش، پروژه‌ها و محصولات فناورانه شرکت معرفی می‌شوند؛ پروژه‌هایی که با هدف توسعه راهکارهای نوآورانه در مرز علم، مهندسی و فناوری شکل گرفته‌اند. دامنه آن‌ها از تحلیل داده‌های نجومی و یادگیری ماشین تا زیرساخت‌های نرم‌افزاری و محیط‌های محاسباتی علمی و مهندسی را در بر می‌گیرد. وضعیت هر پروژه جداگانه بیان می‌شود و پیوندهای عمومی پس از آماده‌سازی و بررسی نهایی منتشر خواهند شد.",
  en: "This section introduces the company’s technology projects and products. Their scope ranges from astronomical data analysis and machine learning to software infrastructure and scientific and engineering computing environments. Each project is described according to its purpose and development status. Public links will be added after the relevant project is ready and reviewed.",
  ar: "يعرض هذا القسم المشاريع والمنتجات التقنية للشركة. وتشمل مجالاتها تحليل البيانات الفلكية والتعلم الآلي والبنية التحتية البرمجية وبيئات الحوسبة العلمية والهندسية. ويُعرض كل مشروع وفق هدفه ومرحلة تطويره، ولن تُنشر الروابط العامة إلا بعد جاهزية المشروع ومراجعته.",
  ru: "В этом разделе представлены технологические проекты и продукты компании. Их тематика охватывает анализ астрономических данных, машинное обучение, программную инфраструктуру и среды научных и инженерных вычислений. Каждый проект описывается с учётом его назначения и стадии разработки. Публичные ссылки будут добавлены после готовности и проверки соответствующего проекта.",
  de: "Dieser Bereich stellt die Technologieprojekte und Produkte des Unternehmens vor. Das Spektrum reicht von astronomischer Datenanalyse und maschinellem Lernen bis zu Softwareinfrastruktur sowie wissenschaftlichen und technischen Rechenumgebungen. Jedes Projekt wird nach Zweck und Entwicklungsstand beschrieben. Öffentliche Links werden erst nach Fertigstellung und Prüfung ergänzt.",
  zh: "本栏目介绍公司的技术项目与产品，涵盖天文数据分析、机器学习、软件基础设施以及科学与工程计算环境。每个项目均按其目标和开发阶段进行说明。相关项目准备就绪并完成审核后，才会发布公开链接。",
  fr: "Cette section présente les projets et produits technologiques de l’entreprise. Leur périmètre va de l’analyse de données astronomiques et de l’apprentissage automatique aux infrastructures logicielles et aux environnements de calcul scientifique et technique. Chaque projet est décrit selon son objectif et son stade de développement. Les liens publics seront ajoutés après préparation et vérification.",
  es: "Esta sección presenta los proyectos y productos tecnológicos de la empresa. Su alcance abarca desde el análisis de datos astronómicos y el aprendizaje automático hasta la infraestructura de software y los entornos de computación científica y de ingeniería. Cada proyecto se describe según su objetivo y etapa de desarrollo. Los enlaces públicos se añadirán después de su preparación y revisión."
};
---
<SiteLayout locale={locale} title={site.navigation.projects + " — " + site.companyName} description={site.projects.map((project) => project.summary).join(" ")}>
  <div class="site-shell">
    <section class="hero" aria-labelledby="projects-title">
      <p class="eyebrow">{site.navigation.projects}</p>
      <h1 id="projects-title">{site.navigation.projects}</h1>
      <p class="lede projects-intro">{projectsIntro[locale]}</p>
    </section>
    <section aria-label={site.navigation.projects}>
      <ProjectCards locale={locale} projects={site.projects} labels={labels} />
    </section>
  </div>
</SiteLayout>
